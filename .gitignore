.zfb-esbuild-entry-*.tsx
.zfb-islands-tsconfig-*.json
.zfb-virtual-*.mjs

# Validator scratch cache (component evidence source cache)
.circuit-cache/

# Packed tarballs at the repo root (verify:pack, npm pack output)
/*.tgz

# Python
__pycache__/

# macOS
.DS_Store

# Environment
.env
.env.local
.env.*.local

